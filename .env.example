MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
WONDER_MODEL=muse-wonder-1.0
SAM_MODEL=sam-3.1
# Offscreen rendering backend: egl (Linux + GPU), osmesa (Linux CPU-only), cgl (macOS)
MUJOCO_GL=egl
SHOWTELL_DATA_DIR=./data
# Backend (all optional). With a token set, POST requests need "Authorization: Bearer <token>";
# without one, only requests from this machine may start jobs.
SHOWTELL_API_TOKEN=
# Jobs that would call the paid API are refused once logged spend reaches this many dollars.
SHOWTELL_BUDGET_USD=100
# Memory cap per simulated seed (MB); 0 turns the cap off.
SHOWTELL_SEED_MEMORY_MB=2048

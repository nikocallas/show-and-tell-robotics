# Copy to web/.env.local for local overrides. Nothing here is secret: every VITE_* value ends up in
# the browser bundle.

# "1" = demo mode by default (replays recorded runs from public/demo/). Production builds set this in
# .env.production; "?live=1" in the URL switches to the live backend when VITE_API_URL is set.
VITE_DEMO=

# Live backend (FastAPI), e.g. https://showtell-api.example.com. Empty = same origin; in `npm run dev`
# the Vite dev server proxies /api and /media to VITE_PROXY_TARGET.
VITE_API_URL=

# Dev server proxy target for /api and /media (default http://localhost:8000).
VITE_PROXY_TARGET=

# Dev only: "1" serves web/dev-fixtures (sample data, not a real run) and a mock /api. Never used by
# `vite build`.
VITE_DEV_FIXTURE=
